{
  "name": "bakery_preorder_app",
  "description": "A bakery pre-order platform where customers browse cakes and pastries, build orders, schedule pickup, and pay online",
  "tech": {
    "backend_port": 8000,
    "frontend_port": 3000,
    "api_base_url": "http://localhost:8000/api",
    "auth_strategy": "jwt",
    "state_management": "context",
    "database": "sqlite3",
    "css_framework": "tailwind",
    "project_type": "fullstack_express",
    "game_engine": "",
    "game_interfaces": {},
    "frontend_framework": "react",
    "python_packages": [],
    "node_packages": {
      "axios": "^1.6.0",
      "react-router-dom": "^6.20.0",
      "express": "^4.19.2",
      "prisma": "^5.14.0",
      "@prisma/client": "^5.14.0",
      "bcrypt": "^5.1.1",
      "jsonwebtoken": "^9.0.2",
      "passport": "^0.7.0",
      "passport-google-oauth20": "^2.0.0",
      "stripe": "^15.7.0",
      "cors": "^2.8.5",
      "dotenv": "^16.4.5"
    },
    "typescript": true,
    "user_roles": [],
    "production_security": true,
    "google_oauth": true,
    "payments": true,
    "payments_effect": false
  },
  "models": [
    {
      "name": "User",
      "app_label": "api",
      "fields": [
        {
          "name": "email",
          "type": "EmailField",
          "kwargs": {
            "unique": "True"
          }
        },
        {
          "name": "password_hash",
          "type": "CharField",
          "kwargs": {
            "max_length": "255",
            "blank": "True",
            "null": "True"
          }
        },
        {
          "name": "google_id",
          "type": "CharField",
          "kwargs": {
            "max_length": "255",
            "blank": "True",
            "null": "True",
            "unique": "True"
          }
        },
        {
          "name": "name",
          "type": "CharField",
          "kwargs": {
            "max_length": "150"
          }
        },
        {
          "name": "is_active",
          "type": "BooleanField",
          "kwargs": {
            "default": "True"
          }
        },
        {
          "name": "created_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now_add": "True"
          }
        },
        {
          "name": "updated_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now": "True"
          }
        }
      ],
      "meta": {
        "ordering": "['-created_at']"
      },
      "str_field": "email"
    },
    {
      "name": "Category",
      "app_label": "api",
      "fields": [
        {
          "name": "name",
          "type": "CharField",
          "kwargs": {
            "max_length": "100"
          }
        },
        {
          "name": "slug",
          "type": "SlugField",
          "kwargs": {
            "unique": "True",
            "max_length": "120"
          }
        },
        {
          "name": "created_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now_add": "True"
          }
        }
      ],
      "meta": {
        "ordering": "['name']"
      },
      "str_field": "name"
    },
    {
      "name": "Product",
      "app_label": "api",
      "fields": [
        {
          "name": "name",
          "type": "CharField",
          "kwargs": {
            "max_length": "200"
          }
        },
        {
          "name": "description",
          "type": "TextField",
          "kwargs": {
            "blank": "True"
          }
        },
        {
          "name": "price",
          "type": "DecimalField",
          "kwargs": {
            "max_digits": "8",
            "decimal_places": "2"
          }
        },
        {
          "name": "image_url",
          "type": "URLField",
          "kwargs": {
            "blank": "True"
          }
        },
        {
          "name": "category",
          "type": "ForeignKey",
          "kwargs": {
            "to": "'Category'",
            "on_delete": "models.CASCADE",
            "related_name": "'products'"
          }
        },
        {
          "name": "is_featured",
          "type": "BooleanField",
          "kwargs": {
            "default": "False"
          }
        },
        {
          "name": "is_available",
          "type": "BooleanField",
          "kwargs": {
            "default": "True"
          }
        },
        {
          "name": "created_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now_add": "True"
          }
        },
        {
          "name": "updated_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now": "True"
          }
        }
      ],
      "meta": {
        "ordering": "['-created_at']"
      },
      "str_field": "name"
    },
    {
      "name": "Order",
      "app_label": "api",
      "fields": [
        {
          "name": "order_number",
          "type": "CharField",
          "kwargs": {
            "max_length": "20",
            "unique": "True"
          }
        },
        {
          "name": "user",
          "type": "ForeignKey",
          "kwargs": {
            "to": "'User'",
            "on_delete": "models.CASCADE",
            "related_name": "'orders'"
          }
        },
        {
          "name": "pickup_date",
          "type": "DateTimeField",
          "kwargs": {}
        },
        {
          "name": "status",
          "type": "CharField",
          "kwargs": {
            "max_length": "20",
            "default": "'pending'"
          }
        },
        {
          "name": "total_amount",
          "type": "DecimalField",
          "kwargs": {
            "max_digits": "10",
            "decimal_places": "2"
          }
        },
        {
          "name": "stripe_payment_intent",
          "type": "CharField",
          "kwargs": {
            "max_length": "255",
            "blank": "True",
            "null": "True"
          }
        },
        {
          "name": "created_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now_add": "True"
          }
        },
        {
          "name": "updated_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now": "True"
          }
        }
      ],
      "meta": {
        "ordering": "['-created_at']"
      },
      "str_field": "order_number"
    },
    {
      "name": "OrderItem",
      "app_label": "api",
      "fields": [
        {
          "name": "order",
          "type": "ForeignKey",
          "kwargs": {
            "to": "'Order'",
            "on_delete": "models.CASCADE",
            "related_name": "'items'"
          }
        },
        {
          "name": "product",
          "type": "ForeignKey",
          "kwargs": {
            "to": "'Product'",
            "on_delete": "models.CASCADE",
            "related_name": "'order_items'"
          }
        },
        {
          "name": "quantity",
          "type": "IntegerField",
          "kwargs": {
            "default": "1"
          }
        },
        {
          "name": "price_at_order",
          "type": "DecimalField",
          "kwargs": {
            "max_digits": "8",
            "decimal_places": "2"
          }
        },
        {
          "name": "created_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now_add": "True"
          }
        }
      ],
      "meta": {
        "ordering": "['id']"
      },
      "str_field": "product"
    }
  ],
